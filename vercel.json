{
  "buildCommand": "pip install -r requirements.txt && pip install -r backend/requirements.txt",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "runtime": "python3.9"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "^/dashboard/?$",
      "dest": "/public/dashboard.html"
    },
    {
      "src": "^/?$",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*\\.html)$",
      "dest": "/public/$1"
    },
    {
      "src": "/(?!api).*",
      "dest": "/public/index.html"
    }
  ]
}
